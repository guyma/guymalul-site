---
import { Image } from 'astro:assets';
// the byline avatar was a 1,846KB 1024x1024 PNG drawn at 48px - twenty-one
// times its rendered size, on every post page. astro:assets resizes and
// converts it at build time, so the reader downloads what is actually shown.
import avatar from '../assets/guy.png';
/**
 * Post.astro - the article template.
 *
 * WHAT THIS IS AND IS NOT. The design is NOT decided - his ruling 21.8:
 * *"מבחינתי עדיין לא החלטנו על עיצוב. מתחילים שוב כשעוברים לאסטרו."* This
 * layout carries the STRUCTURE and the MEASURED bands, so a design round has a
 * real article to run on. It is a starting point, not a locked look.
 *
 * Every number below traces to guy-hq/knowledge/research/hebrew-web-study.md,
 * measured on seven live Hebrew blogs:
 *   - column 620-830px          (field median 824; nobody under 43% of viewport)
 *   - body 17-18px              (field median 17)
 *   - line-height 1.75-1.85     (clusters at 1.80-1.85 on 4 of 7)
 *   - lands at 75-90 Hebrew characters per line
 *
 * The furniture is the measured baseline: a kicker (4/7), a standfirst (3/7),
 * a byline with a real portrait (4/7 use a photo), an h2 spine (7/7), and a
 * conversion block after the body (7/7 - not one site ends the article at the
 * article). The pull quote is ours: 5 of 7 competitors have no blockquote at all.
 */
import Base from './Base.astro';
import type { CollectionEntry } from 'astro:content';

interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const d = post.data;

const dateHe = new Intl.DateTimeFormat('he-IL', {
  day: 'numeric', month: 'long', year: 'numeric',
}).format(d.pubDate);
const iso = d.pubDate.toISOString();

const site = Astro.site ?? new URL('https://guymalul.co.il');
const url = new URL(`/blog/${post.id}/`, site).href;

// Our own JSON-LD. astro-seo-schema HTML-escapes every string inside the
// script tag, so every Hebrew apostrophe would ship as &apos;.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  datePublished: iso,
  ...(d.updatedDate && { dateModified: d.updatedDate.toISOString() }),
  inLanguage: 'he-IL',
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  author: { '@type': 'Person', name: 'גיא מלול', url: site.href },
  publisher: { '@type': 'Organization', name: 'גיא מלול', url: site.href },
  ...(d.tags.length && { keywords: d.tags.join(', ') }),
};
---

<Base title={`${d.title} | גיא מלול`} description={d.description} canonical={url} ogType="article" share>
  <Fragment slot="head">
    {/* set:html, not a JSON string in the body - so Hebrew stays Hebrew */}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <article class="post">
    <header class="masthead">
      {d.kicker && <p class="kicker">{d.kicker}</p>}
      <h1>{d.title}</h1>
      {d.standfirst && <p class="standfirst">{d.standfirst}</p>}

      <div class="byline">
        <Image class="ava" src={avatar} alt="גיא מלול" width={96} height={96} loading="eager" />
        <div>
          <span class="who">גיא מלול</span>
          <span class="meta">
            <time datetime={iso}>{dateHe}</time>
            {d.readingTime && <> · {d.readingTime} דקות קריאה</>}
          </span>
        </div>
      </div>
    </header>

    <div class="prose">
      <slot />
    </div>

    {/* The closing block is PER POST and optional. It used to be hardcoded
        here with post #1's three questions, which meant two things at once:
        it went stale the moment that post changed, and every future post
        would have carried another post's summary. A post supplies its own
        via frontmatter, or gets none. */}
    {d.payoff && (
      <aside class="payoff">
        <p class="payh">{d.payoff.title}</p>
        <ol>{d.payoff.items.map((x) => <li>{x}</li>)}</ol>
      </aside>
    )}

    {d.tags.length > 0 && (
      <p class="tags">{d.tags.map((t) => <span class="tag">{t}</span>)}</p>
    )}

    <p class="back"><a href="/blog/">כל הפוסטים</a></p>
  </article>

<script is:inline>
  // Wrap every prompt box and give it a copy control. Done in the browser rather
  // than in the markdown so the post source stays plain text a person can read.
  //
  // ONLY prompts. A fence with a language is real code (Shiki gives it
  // data-language); it keeps its own styling and gets no "copy the prompt"
  // button, because that button would be lying about what it copies.
  document.querySelectorAll('.prose pre:not([data-language])').forEach(function (pre) {
    if (pre.parentElement.classList.contains('box')) return;
    var box = document.createElement('div');
    box.className = 'box';
    pre.parentNode.insertBefore(box, pre);
    box.appendChild(pre);

    var IDLE = 'העתקה', OK = 'הועתק', FAIL = 'לא הצליח';
    var b = document.createElement('button');
    b.type = 'button';
    b.className = 'copy';
    // The accessible name is kept IN STEP with the visible text. A fixed
    // aria-label would override it, so a screen reader would hear "copy the
    // prompt" forever and never learn whether the copy worked.
    var say = function (text, label) {
      b.textContent = text;
      b.setAttribute('aria-label', label);
    };
    b.setAttribute('aria-live', 'polite');
    say(IDLE, 'להעתיק את הפרומפט');
    box.appendChild(b);

    var timer;
    var reset = function () {
      clearTimeout(timer);
      timer = setTimeout(function () {
        say(IDLE, 'להעתיק את הפרומפט');
        b.removeAttribute('data-done');
      }, 1800);
    };
    var done = function () { say(OK, 'הפרומפט הועתק'); b.setAttribute('data-done', ''); reset(); };
    var failed = function () { say(FAIL, 'ההעתקה לא הצליחה'); b.removeAttribute('data-done'); reset(); };

    b.addEventListener('click', function () {
      var text = (pre.querySelector('code') || pre).innerText;

      function fallback() {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.cssText = 'position:absolute;left:-9999px';
        document.body.appendChild(ta);
        ta.select();
        // execCommand is deprecated and astro check says so. It is kept on
        // purpose as a fallback for a non-secure context and older browsers.
        // It RETURNS A BOOLEAN and can fail WITHOUT throwing, so the return
        // value is what decides - a try/catch alone reports success on failure.
        var ok = false;
        try { ok = document.execCommand('copy') !== false; }
        catch (err) { ok = false; }
        document.body.removeChild(ta);
        if (ok) done(); else failed();
      }

      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(done, fallback);
      } else fallback();
    });
  });
</script>
</Base>

<style is:global>
  body { margin: 0; background: var(--ground); color: var(--ink); font-family: var(--font); }

  .post { max-width: 46rem; margin: 0 auto; padding: clamp(2rem, 7vw, 4.5rem) var(--pad-x) 5rem; }

  /* the kicker: a small coral label. 4 of 7 competitors carry one */
  .kicker {
    display: flex; align-items: center; gap: 10px;
    color: var(--acc-d); font-weight: 500; font-size: .95rem;
    margin: 0 0 .75rem; letter-spacing: .01em;
  }
  .kicker::before {
    content: ""; width: 26px; height: 3px; background: var(--acc);
    border-radius: 2px; flex: none;
  }

  .post h1 {
    font-size: clamp(2rem, 5.2vw, 2.9rem); line-height: 1.12;
    font-weight: 700; margin: 0 0 1rem; letter-spacing: -.01em; color: var(--ink);
  }

  .standfirst { max-width: 44rem;
    font-size: clamp(1.12rem, 2.2vw, 1.32rem); line-height: 1.62;
    color: var(--ink); font-weight: 400; margin: 0 0 1.6rem;
  }

  .byline {
    display: flex; align-items: center; gap: .8rem;
    padding-top: 1.1rem; border-top: 1px solid var(--line); margin-bottom: 2.6rem;
  }
  .byline .ava { width: 48px; height: 48px; border-radius: 50%; flex: none; background: var(--acc-tint); }
  .byline .who { display: block; font-weight: 500; color: var(--ink); }
  .byline .meta { display: block; font-size: .88rem; color: var(--muted); }

  /* the reading column - the measured band */
  .prose { font-size: 1.0625rem; line-height: 1.8; color: var(--body); }
  .prose > * { max-width: 44rem; }  /* 704px - the measured band is 620-830 */
  .prose p { margin: 0 0 1.35rem; }
  .prose strong { color: var(--ink); font-weight: 700; }
  .prose em { font-style: italic; }
  .prose a { color: var(--acc-d); }

  .prose h2 {
    font-size: clamp(1.42rem, 3.2vw, 1.8rem); line-height: 1.25; font-weight: 700;
    color: var(--ink); margin: 3.2rem 0 1rem;
  }
  .prose h3 {
    font-size: 1.18rem; line-height: 1.35; font-weight: 700;
    color: var(--ink); margin: 2.2rem 0 .7rem;
  }

  .prose ul, .prose ol { margin: 0 0 1.35rem; padding-inline-start: 1.35em; }
  .prose li { margin-bottom: .5rem; }

  /* the pull quote breaks OUT of the column - 5 of 7 competitors have none */
  .prose blockquote {
    margin: 2.4rem 0; padding-inline-end: 1.4rem;
    border-inline-end: 4px solid var(--acc);
    font-size: clamp(1.25rem, 2.6vw, 1.55rem); line-height: 1.45;
    font-weight: 500; color: var(--ink); max-width: 38rem;
  }
  .prose blockquote p { margin: 0; }

  .prose hr { border: 0; border-top: 1px solid var(--line); margin: 3rem 0 2rem; }

  /* INLINE code only - a Latin technical token inside a sentence. This rule
     used to hit <code> inside <pre> too, which is what broke the prompt boxes:
     the block inherited a light text colour from Astro's dark <pre> theme and
     then sat on this light background, so the text was invisible, and it
     inherited direction:ltr, so Hebrew rendered with its punctuation at the
     start of the line. Caught by SCREENSHOTTING the page, never by a check. */
  .prose :not(pre) > code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: .92em; background: var(--acc-tint);
    padding: 1px 6px; border-radius: 6px;
    direction: ltr; unicode-bidi: isolate; display: inline-block;
  }
  .prose kbd, .prose samp { direction: ltr; unicode-bidi: isolate; display: inline-block; }

  /* THE PROMPT BOX. hebrew-writing law 20c: this is text the reader PASTES,
     so it is judged as a prompt - clarity to the model beats cadence. Its
     content here is Hebrew, so it reads right-to-left like the rest of the
     page, and it must never inherit a syntax theme meant for code. */
  /* A PROMPT is a fence with no language; astro.config excludes plaintext from
     Shiki, so it arrives as a bare <pre>. Real code arrives with data-language
     and Shiki's own theme, and must not be dressed as a prompt or flipped RTL. */
  .prose pre:not([data-language]) {
    background: var(--tone, #fef0ec);
    color: var(--ink, #2b1f1c);
    direction: rtl;
    text-align: start;
    padding: 1.15rem 1.3rem;
    border-radius: 14px;
    border: 1px solid var(--acc-line, #f0c4b8);
    margin: 1.8rem 0;
    line-height: 1.75;
    font-size: .92rem;
    /* No !important here on purpose. Shiki used to write background-color
       INLINE on every <pre>, and the first fix was to out-shout it. The real fix
       was excluding plaintext from the highlighter in astro.config; once the root
       cause was gone the override was left behind as dead weight. A workaround
       kept after its cause is removed teaches the next reader the wrong lesson. */
    /* and a long Hebrew line was being CLIPPED on a phone rather than wrapped.
       overflow-x:auto scrolls a block nobody thinks to scroll sideways. */
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  /* real code: Shiki's theme, left-to-right, and its own sideways scroll */
  .prose pre[data-language] {
    margin: 1.8rem 0; padding: 1.15rem 1.3rem; border-radius: 14px;
    direction: ltr; text-align: left; font-size: .92rem; line-height: 1.7;
    overflow-x: auto;
  }
  .prose pre:not([data-language]) code {
    background: none; padding: 0; border-radius: 0; font-size: inherit;
    color: inherit; direction: inherit; unicode-bidi: normal; display: block;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }


  /* the conversion block. 7 of 7 competitors carry one; not one ends the
     article at the article */

  /* THE COPY BUTTON. Measured across the seven Hebrew sites in the field study:
     a copy-to-clipboard control on a prompt or code block is 0 of 7. Nobody
     does it. On a post whose whole point is "copy this and run it", that is an
     opening rather than a reason to skip it. */
  .prose .box { position: relative; }
  .prose .box .copy {
    position: absolute; top: 10px; inset-inline-end: 10px;
    background: var(--ground); color: var(--acc-d);
    border: 1px solid var(--acc-line); border-radius: 999px;
    font-family: var(--font); font-size: .8rem; font-weight: 500;
    padding: 5px 13px; cursor: pointer; line-height: 1;
    display: inline-flex; align-items: center; justify-content: center; gap: 6px;
  }
  /* A thumb needs about 44px and the pill is 25. The visible pill stays small;
     an invisible pseudo-element carries the touch target around it. */
  .prose .box .copy::after {
    content: ""; position: absolute; top: -11px; bottom: -11px; left: -8px; right: -8px;
  }
  .prose .box .copy:hover { background: var(--acc-tint); }
  .prose .box .copy:focus-visible { outline: 2px solid var(--acc); outline-offset: 2px; }
  .prose .box .copy[data-done] { color: var(--ink); border-color: var(--line); }
  /* the button sits over the first line, so the box makes room for it */
  .prose .box pre { padding-top: 2.9rem; }
  @media (prefers-reduced-motion: no-preference) { .prose .box .copy { transition: background .15s; } }

  .payoff {
    max-width: 44rem; margin-top: 3.4rem; padding-top: 1.6rem;
    border-top: 3px solid var(--acc);
  }
  .payoff .payh { font-weight: 700; color: var(--ink); margin: 0 0 .7rem; }
  .payoff ol { margin: 0; padding-inline-start: 1.3em; color: var(--body); }
  .payoff li { margin-bottom: .4rem; }

  .tags { margin: 2.4rem 0 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .tag {
    font-size: .82rem; color: var(--acc-d); background: var(--acc-tint);
    padding: 3px 11px; border-radius: 99px;
  }

  .back { margin-top: 2.6rem; font-size: .95rem; }
  .back a { color: var(--acc-d); font-weight: 500; }
</style>
