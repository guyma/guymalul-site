---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Proof from '../components/Proof.astro';
import { Image } from 'astro:assets';
import avatar from '../assets/guy.png';
---

<Base
  title={"העובד הראשון שלך | גיא מלול"}
  description={"בסדנה אחת אני מלמד אותך לגייס עובד AI שמכיר את העסק שלך. שלוש שעות בזום, בלי לכתוב שורת קוד."}
  canonical={"https://guymalul.co.il/"}
  ogImage={"https://guymalul.co.il/og-card-v4.png"}
  ogImageAlt={"מספיק להאכיל את הצ'אט בכפית. בסדנה אחת אתה לומד לגייס עובד AI שמכיר את העסק שלך."}
  ogTitle={"העובד הראשון שלך | גיא מלול"}
  ogDescription={"בסדנה אחת אני מלמד אותך לגייס עובד AI שמכיר את העסק שלך. שלוש שעות בזום, בלי לכתוב שורת קוד."}
  twitterTitle={"העובד הראשון שלך | גיא מלול"}
  twitterDescription={"בסדנה אחת אני מלמד אותך לגייס עובד AI שמכיר את העסק שלך. שלוש שעות בזום, בלי לכתוב שורת קוד."}
  favicon={"/favicon.svg"}
  appleTouchIcon={"/apple-touch-icon.png"}
  share
>
  <style is:global>
  /* ===========================================================
     The locked brand language (core/design in guy-hq is the truth).
     The ground is flat white and never moves. ONE warm coral, and it
     means one thing: you can press this. It arrives as whole blocks
     with generous rounded corners, never as a tint over the page.
     Hierarchy comes from size and space. Anything coloured that you
     CANNOT press carries no fill and no frame - a mark and a line.
     =========================================================== */
  :root {
    --ground: #ffffff;
    --tone:   #fef0ec;   /* one second tone, to GROUP two sections */
    --ink:    #2b1f1c;   /* ~15:1 on white */
    --body:   #6b5a55;   /* ~6.3:1 */
    --muted:  #7d6e69;   /* ~5:1 - the secondary greys have to clear AA too */
    --line:   #eee6e3;
    --line-tone: #f4d8d0;
    --acc:      #c0563f;   /* fills only; white on it is 4.5:1, AA */
    --acc-d:    #a84634;   /* ~5.6:1 on white - coloured TEXT and hover */
    --acc-tint: #fdeae4;   /* a flat wash, never a gradient */
    --acc-line: #f0c4b8;
    --font: 'Rubik', system-ui, -apple-system, 'Segoe UI', sans-serif;

    --bar: 52px;
    --pad-x: clamp(1.25rem, 5vw, 2rem);
    --sec-y: clamp(3.6rem, 12vw, 6rem);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  /* NOT scroll-behavior: smooth here. With overflow-x:hidden on html and body
     (the line below), Chrome silently no-ops smooth fragment scrolling - the
     hash changes and the page does not move. Measured 12.8: auto lands at
     5,818, smooth lands at 0. The instant jump is the working behaviour. */
  html { -webkit-text-size-adjust: 100%; }
  html, body { overflow-x: hidden; max-width: 100%; }

  body {
    font-family: var(--font);
    font-size: 17px;
    font-weight: 400;
    line-height: 1.7;
    background: var(--ground);
    color: var(--body);
    -webkit-font-smoothing: antialiased;
    overflow-wrap: break-word;
  }

  ::selection { background: var(--acc-tint); }

  /* ---------- structure ---------- */
  main { position: relative; }
  /* the skip link IS pressable, so it wears the page's pressable signature -
     the fill and the 12px rounded corner. Off-screen until focused, first tab stop. */
  .skip {
    position: fixed;
    inset-inline-start: var(--pad-x);
    top: -120px;
    z-index: 100;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.55rem 1.15rem;
    border-radius: 12px;
    background: var(--acc);
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
  }
  .skip:focus { top: 0.4rem; }
  /* focus is never suppressed anywhere on this page; the skip target ADDS an
     indicator rather than removing one, so the jump is visible where it lands */
  #main:focus { outline: 2px solid var(--acc); outline-offset: -4px; }

  section {
    padding: var(--sec-y) var(--pad-x);
    border-top: 1px solid var(--line);
  }
  section.hero { border-top: none; }
  /* the second tone groups the two sections that belong together:
     what you are getting into, and what it costs. One band, not a zebra. */
  section.tone { background: var(--tone); }
  section.tone + section.tone { border-top: none; }
  section.tone + section { border-top: none; }
  .wrap { max-width: 660px; margin: 0 auto; }

  /* ---------- type ---------- */
  h1, h2 {
    color: var(--ink);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.12;
  }
  /* the headings are sentences now, not labels: one notch down from the
     label scale so they stay a heading and the H1 stays the only big thing */
  h2 {
    font-size: clamp(1.55rem, 6.8vw, 2.1rem);
    margin-bottom: 1.5rem;
    text-wrap: balance;
  }

  p { margin-bottom: 1.15rem; }
  p:last-child { margin-bottom: 0; }
  strong { color: var(--ink); font-weight: 700; }

  a { color: var(--acc-d); font-weight: 500; }
  .body-link {
    display: inline-block;
    padding: 0.9rem 0.25rem;
    margin: -0.9rem -0.25rem;
    text-decoration: underline;
    text-underline-offset: 0.22em;
    text-decoration-thickness: 1px;
  }

  /* a section's opening line: one notch above body, ink, never coloured */
  .lede {
    font-size: 1.18rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--ink);
    margin-bottom: 1.6rem;
  }

  /* ---------- buttons: flat solid fill, rounded rectangle, no gradient, no glow ----------
     The 12px corner plus a saturated fill is the page's ONE pressable signature -
     never a pill. Nothing that cannot be pressed is allowed to wear it. */
  .btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 420px;
    min-height: 54px;
    padding: 0.85rem 1.8rem;
    border-radius: 12px;
    background: var(--acc);
    color: #ffffff;
    font-size: 1.06rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .btn:hover, .btn:focus-visible { background: var(--acc-d); }
  .cta-row { margin-top: 2rem; }

  /* the secondary button: the same fill, separated by SIZE. A real
     destination that isn't the sale still has to read as pressable, and an
     outline reads as decoration next to a solid page. */
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 46px;
    padding: 0.65rem 1.25rem;
    border: 1.5px solid var(--acc);
    border-radius: 12px;
    background: var(--acc);
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.3;
    text-decoration: none;
    transition: filter 0.2s ease;
  }
  .btn-ghost:hover, .btn-ghost:focus-visible { filter: brightness(0.9); }
  .btn-ghost svg { width: 15px; height: 15px; fill: currentColor; flex: none; }
  .btn-row { margin: 1.4rem 0 1.5rem; }
  .soft-line {
    margin-top: 1.1rem;
    margin-bottom: 0;
    font-size: 0.95rem;
    color: var(--muted);
  }

  /* =================== the fold ===================
     The eyebrow, the headline, who and what, one short spoken paragraph
     and the button: one opening, on one screen. */
  .hero {
    padding-top: calc(var(--bar) + 3rem);
    padding-bottom: var(--sec-y);
  }
  /* above the headline: the line that lowers the guard, and the page's model
     for every coloured thing you cannot press. No fill and no frame - a solid
     rule, then the words in the accent. It carries the hue at full strength,
     so it is not quiet, but it wears none of the button's signature, so it
     never promises a tap it cannot honour. */
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0;
    border: none;
    background: none;
    font-size: 0.94rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--acc-d);
    margin-bottom: 1.7rem;
  }
  .eyebrow::before {
    content: "";
    flex: none;
    width: 22px;
    height: 4px;
    background: var(--acc);
  }
  .hero h1 {
    font-size: clamp(2.4rem, 11vw, 3.9rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: 0.6rem;
  }
  .hero h1 .h1-say { display: block; text-wrap: balance; }
  /* the H1's second clause: the kick under the claim. It is subordinate by
     SIZE (0.72 of the H1) so it reads as a rider, never as a second headline -
     the profile's rule that hierarchy comes from size. Colour is the second
     channel, never the only one, and it carries no underline so it cannot be
     mistaken for something to press. */
  .hero h1 .h1-ask {
    text-wrap: balance;
    display: block;
    font-size: 0.72em;
    line-height: 1.2;
    margin-top: 0.34em;
    letter-spacing: -0.02em;
    color: var(--acc);
    text-decoration: none;
  }

  /* a number and its unit, and the H1's last two words, never split across
     lines - at 390px the violet clause was orphaning its final word. */
  .nb { white-space: nowrap; }

  /* one paragraph, three beats, all at body size */
  .said { font-size: 1.0625rem; line-height: 1.65; margin-bottom: 0; }
  .said .b-frag { display: block; color: var(--ink); font-weight: 500; margin-bottom: 0.5rem; }
  .said .b-pain { display: block; }
  .said .b-punch { display: block; color: var(--ink); font-weight: 700; margin-top: 0.75rem; }

  /* on the closing colour block the button inverts: white is what you press there */
  .final .btn { background: #ffffff; color: var(--acc-d); }
  .final .btn:hover, .final .btn:focus-visible { background: var(--acc-tint); }
  .final .soft-line { color: #ffe0d6; }
  .final .soft-line a { color: #ffffff; }

  /* ---------- callouts: two on the whole page, and that is the design ----------
     A frame here means "this one will cost you if you skip it". Three signals
     carry it and none of them is hue: the shape of the icon (triangle vs
     circle), the label word, and the frame itself. The colour only tunes the
     temperature. Five framed blocks would be five unframed blocks. */
  /* a callout that ENDS a section adds its own 2rem on top of the section's
     96px, and because it closes on a hard border the space reads bigger than
     it measures. Nothing follows it inside the section, so the margin is
     redundant there. */
  .callout:last-child { margin-bottom: 0; }
  .callout {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    margin: 2rem 0;
    padding: 1rem 1.15rem 1.05rem;
    border: 1px solid var(--co-line);
    border-inline-start: 3px solid var(--co-edge);
    border-radius: 16px;
    background: var(--co-bg);
    color: var(--ink);
  }
  .callout .co-ic { flex: none; width: 1.25rem; height: 1.25rem; margin-top: 0.28rem; fill: var(--co-edge); }
  .callout .co-body { min-width: 0; }
  .callout .co-label {
    display: block;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    line-height: 1.5;
    color: var(--co-text);
    margin-bottom: 0.15rem;
  }
  .callout p { color: var(--ink); }
  /* the warning is the page's one INK callout: the hue is spent on what you
     can press, so the hard constraint separates itself by going neutral and
     letting the triangle and the label word carry it. */
  .callout--warn { --co-bg: #f6f6f6; --co-line: #e0e0e0; --co-edge: var(--ink); --co-text: var(--ink); }
  .callout--info { --co-bg: var(--acc-tint); --co-line: var(--acc-line); --co-edge: var(--acc); --co-text: var(--acc-d); }
  .tone .callout--info { --co-bg: #ffffff; }

  /* ---------- lists ---------- */
  .gets { list-style: none; margin: 1.3rem 0 1.6rem; }
  .gets li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 0.8rem 0;
    border-top: 1px solid var(--line);
  }
  .gets li:last-child { border-bottom: 1px solid var(--line); }
  .tone .gets li { border-color: var(--line-tone); }
  .gets .yes {
    flex: none;
    width: 1.4rem;
    height: 1.4rem;
    margin-top: 0.3rem;
    border-radius: 50%;
    background: var(--acc);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .no {
    flex: none;
    width: 1.4rem;
    height: 1.4rem;
    margin-top: 0.3rem;
    border-radius: 50%;
    border: 1.5px solid #c4c4c4;
    color: var(--ink);
    font-size: 0.7rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .duo-title { color: var(--ink); font-weight: 700; margin-bottom: 0; }

  /* ---------- the offer: the price's card, with the coloured edge ---------- */
  .offer {
    background: var(--ground);
    border: 1px solid var(--acc-line);
    border-radius: 16px;
    box-shadow: 0 3px 10px rgba(212, 101, 78, 0.12);
    padding: clamp(1.3rem, 5vw, 1.9rem);
    margin-bottom: 1.6rem;
  }
  .offer .gets { margin: 0; }
  .offer .gets li { border-color: var(--line); }
  .offer .gets li:first-child { border-top: none; padding-top: 0; }
  .offer .gets li:last-child { border-bottom: none; padding-bottom: 0; }

  /* ---------- FAQ ---------- */
  .faq-list { margin-top: 0.4rem; }
  .faq-list details { border-bottom: 1px solid var(--line); }
  .faq-list details:first-of-type { border-top: 1px solid var(--line); }
  .faq-list summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 60px;
    padding: 1.1rem 0;
    font-weight: 500;
    font-size: 1.06rem;
    line-height: 1.5;
    color: var(--ink);
  }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary .tog {
    flex: none;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 50%;
    border: 1px solid var(--acc-line);
    background: var(--acc-tint);
    color: var(--acc);
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s ease;
  }
  .faq-list details[open] summary .tog { transform: rotate(45deg); }
  .faq-body { padding: 0 0 1.3rem; }

  /* ---------- the close: the second whole block of colour ---------- */
  section.final { background: var(--acc); border-top: none; }
  .final h2 { color: #ffffff; }
  .final .lead { color: #ffffff; font-size: 1.18rem; font-weight: 500; line-height: 1.55; }
  .final .after { margin-top: 1.2rem; margin-bottom: 0; color: #ffe0d6; }


  /* =================== one claim per section ===================
     Every headline states the section's point; the sentence that leads into
     it is a small line above, so a reader of headlines alone gets the story. */
  .bridge {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--muted);
    margin-bottom: 0.45rem;
  }
  .fold-who { font-size: 1rem; color: var(--body); margin-bottom: 1.8rem; }
  .fold-who b { color: var(--ink); font-weight: 700; }
  .hero .cta-row { margin-top: 2rem; }

  /* the facts every skimmer asks first, as one row */
  .facts {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 1.6rem;
  }
  .facts li {
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  /* before, on Zoom, after: a rail and a word on every step, so order never rides on colour */
  .beats {
    list-style: none;
    display: grid;
    gap: 0.55rem;
    margin: 0 0 1.6rem;
    padding-inline-start: 0.9rem;
    border-inline-start: 2px solid var(--line);
  }
  .beats li { line-height: 1.55; color: var(--body); }
  .beats b { color: var(--ink); margin-inline-end: 0.3rem; }

  /* three cards: what you build, the room, what stays with you */
  .cards3 { list-style: none; display: grid; gap: 0.9rem; margin: 0 0 1.6rem; }
  .card3 {
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 1.1rem 1.2rem 1.2rem;
  }
  /* the card's mark: a shape that says what the card is about, never a colour code -
     the title next to it carries the meaning */
  .card3 .ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 12px;
    background: var(--acc-tint);
    margin-bottom: 0.6rem;
  }
  .card3 .ic svg { width: 1.3rem; height: 1.3rem; fill: var(--acc-d); }
  .card3 h3 { font-size: 1.15rem; line-height: 1.35; color: var(--ink); font-weight: 700; margin-bottom: 0.45rem; }
  .card3 p { font-size: 1rem; line-height: 1.6; }
  .card3 .card-q { color: var(--ink); font-weight: 500; margin-bottom: 0.4rem; }
  .me-line {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    padding-top: 1.2rem;
    border-top: 1px solid var(--line);
    font-size: 0.98rem;
  }
  .me-line .me-ava {
    flex: none;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    object-fit: cover;
    background: var(--tone);
  }
  .me-line p { margin: 0; }
  .me-line strong { display: block; }

  /* for whom: the two titled lists sit side by side even on a phone */
  .duo2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; margin: 0 0 1.6rem; }
  .duo2 .duo-col {
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 0.9rem 0.85rem;
  }
  .tone .duo2 .duo-col { border-color: var(--line-tone); background: #ffffff; }
  .offer > p { margin-top: 1rem; padding-top: 0.9rem; border-top: 1px solid var(--line); }
  .duo2 .duo-title { display: flex; gap: 0.45rem; align-items: center; font-size: 0.98rem; line-height: 1.35; margin-bottom: 0.55rem; }
  .duo2 ul { list-style: none; }
  .duo2 li { font-size: 0.93rem; line-height: 1.45; padding: 0.4rem 0; border-top: 1px solid var(--line); }
  .tone .duo2 li { border-color: var(--line-tone); }
  .duo2 .yes, .duo2 .no { width: 1.25rem; height: 1.25rem; margin: 0; font-size: 0.68rem; }
  .duo2 .yes {
    flex: none;
    border-radius: 50%;
    background: var(--acc);
    color: #ffffff;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .honest-line { color: var(--ink); }
  .needs { margin: 1.4rem 0 0; }
  .needs-title { color: var(--ink); font-weight: 700; margin-bottom: 0.5rem; }
  .needs ul { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.8rem; }
  .needs li {
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--line-tone);
    background: #ffffff;
    border-radius: 999px;
    font-size: 0.93rem;
    color: var(--ink);
  }

  /* the proof's end: a button right where the page peaks */
  .proof-cta { margin-top: 2rem; }

  /* ---------- from tablet up ---------- */
  @media (min-width: 640px) {
    .btn { width: auto; display: inline-flex; }
    .hero { padding-top: calc(var(--bar) + 6rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
</style>
<a class="skip" href="#main">דלג לתוכן</a>

  <SiteHeader current="home" brandHref="#top" ctaLabel="להצטרף לסדנה" ctaHref="#price" />

  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <!-- the two callout marks. Triangle vs circle: the signal survives
           with every drop of colour removed. -->
      <symbol id="ic-warn" viewBox="0 0 24 24">
        <path fill-rule="evenodd" d="M12 2.4 23 21.4H1L12 2.4Zm0 4.6a1.1 1.1 0 0 0-1.1 1.1v5.3a1.1 1.1 0 0 0 2.2 0V8.1A1.1 1.1 0 0 0 12 7Zm0 8.7a1.25 1.25 0 1 0 0 2.5 1.25 1.25 0 0 0 0-2.5Z"/>
      </symbol>
      <symbol id="ic-info" viewBox="0 0 24 24">
        <path fill-rule="evenodd" d="M12 1.9a10.1 10.1 0 1 0 0 20.2 10.1 10.1 0 0 0 0-20.2Zm0 3.6a1.3 1.3 0 1 1 0 2.6 1.3 1.3 0 0 1 0-2.6Zm0 4a1.1 1.1 0 0 1 1.1 1.1v5.9a1.1 1.1 0 0 1-2.2 0v-5.9A1.1 1.1 0 0 1 12 9.5Z"/>
      </symbol>
      <symbol id="ic-ext" viewBox="0 0 24 24">
        <path d="M5 3h6v2H5.99L6 18h12v-5h2v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z"/>
        <path d="M14 3h7v7h-2V6.42l-7.3 7.29-1.41-1.42L17.58 5H14V3Z"/>
      </symbol>
    </defs>
  </svg>

  <main id="main" tabindex="-1">

    <!-- ===== הפתיחה (the fold) ===== -->
    <section class="hero" id="top">
      <div class="wrap">
        <p class="eyebrow rev">בלי לכתוב שורת קוד, ובלי להיות איש מחשבים</p>
