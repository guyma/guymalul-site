---
/**
 * /recorded/ - the recorded workshop's sales page. Guy sends this address himself to people
 * who want the workshop at their own pace. No page on the site links here, so a visitor to the
 * site never meets it, while search may index it: a buyer who finds it there is welcome.
 * The copy's source of truth is guy-hq desk/2026-11-19-round-table-office-focus/ (25-page-v5.md,
 * the opening from 28-round4-opening/04-table-answers.md, the reviews' fixes in 29-reviews/);
 * change it there first. The bio (.me-line) tells the same facts as the home page's: a change to one
 * is made on both.
 */
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Proof from '../../components/Proof.astro';
import { Image } from 'astro:assets';
import avatar from '../../assets/guy.png';
import teamDana from '../../assets/team-dana.png';
import teamDale from '../../assets/team-dale.png';
import teamRozin from '../../assets/team-rozin.png';
import teamEditor from '../../assets/team-editor.png';
import '../../styles/sales-page.css';
import '../../styles/recorded.css';

const PAY = 'https://pay.sumit.co.il/116dead/176qkez/176nu9g/payment';
const WA = 'https://wa.me/972559526627?text=' + encodeURIComponent('היי גיא, יש לי שאלה על הסדנה המוקלטת.');
const promise = 'צוות AI שעושה את העבודה שלך, בדרך שלך.';
const description = promise + ' הסדנה "העובד הראשון שלך", מוקלטת ומחולקת לשיעורים: 497 ש"ח, וגישה ל-60 יום.';
const shareTitle = 'לצוות שכבר מכיר אותך מסבירים פעם אחת.';
const shareDescription = 'סדנה מוקלטת, ולא צריך להבין במחשבים. מלמדים את הצוות, כמו עובד חדש, איך כותבים אצלך מיילים, הודעות ופוסטים.';
---

<Base
  title={"הסדנה המוקלטת | גיא מלול"}
  description={description}
  ogImage={"og-recorded-v1.jpg"}
  ogImageAlt={promise}
  ogTitle={shareTitle}
  ogDescription={shareDescription}
  twitterTitle={shareTitle}
  twitterDescription={shareDescription}
  favicon={"/favicon.svg"}
  appleTouchIcon={"/apple-touch-icon.png"}
  share
>
<a class="skip" href="#main">דלג לתוכן</a>

  <SiteHeader brandHref="#top" ctaLabel="לקנות את הסדנה" ctaHref="#price" />

  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <symbol id="ic-warn" viewBox="0 0 24 24">
        <path fill-rule="evenodd" d="M12 2.4 23 21.4H1L12 2.4Zm0 4.6a1.1 1.1 0 0 0-1.1 1.1v5.3a1.1 1.1 0 0 0 2.2 0V8.1A1.1 1.1 0 0 0 12 7Zm0 8.7a1.25 1.25 0 1 0 0 2.5 1.25 1.25 0 0 0 0-2.5Z"/>
      </symbol>
    </defs>
  </svg>

  <main id="main" class="rec rec-before" tabindex="-1">

    <!-- ===== הפתיחה (the fold) ===== -->
    <section class="hero" id="top">
      <div class="wrap">
        <div class="main">
          <p class="eyebrow rev">לא צריך להבין במחשבים</p>
          <h1>
            <span class="h1-say">צוות AI שעושה את העבודה שלך, בדרך&nbsp;שלך.</span>
          </h1>
          <p class="promise-under rev">בסדנה אחת אני מלמד אותך לגייס עובדי&nbsp;AI שמכירים את העסק שלך, ולנהל&nbsp;אותם.</p>
          <div class="fold-gets rev">
            <p class="fold-gets-title">מה מקבלים?</p>
            <ul>
              <li>13 שיעורים מוקלטים, בערך&nbsp;שעתיים.</li>
              <li>שבע משימות חפיפה, ובסופן הצוות עושה עבודה&nbsp;ראשונה&nbsp;לבד.</li>
              <li>קבוצת הבוגרים&nbsp;בוואטסאפ.</li>
            </ul>
          </div>
        </div>
        <div class="buy">
          <p class="buy-name buy-name--wide rev">הסדנה <b>"העובד הראשון שלך"</b>, מוקלטת ומחולקת&nbsp;לשיעורים.</p>
          <p class="fold-who rev">
            <span class="was"><span class="was-label">בזום</span> <s>1,000 ש"ח</s></span>
            <b>497 ש"ח</b><span class="sep">,</span> ויש לך גישה <span class="nb">ל-60 יום</span>&nbsp;מהקנייה.
          </p>
          <div class="cta-row">
            <a class="btn" href="#price">לקנות את הסדנה המוקלטת</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== הפער ===== -->
    <section id="gap">
      <div class="wrap">
        <h2 class="rev-h">"זה לא באמת מכיר אותי, ואין לי כוח להסביר הכול מחדש כל&nbsp;פעם."</h2>
        <p class="said rev"><span class="b-pain">פתחת צ'אט, הסברת, העתקת, הדבקת.</span> <span class="b-pain">בעצם, עבדת&nbsp;בשבילו.</span></p>
        <div class="learned rev">
          <figure class="learned-who"><Image src={teamDana} alt="" width={300} /><figcaption><b>דנה</b> מנהלת המשרד, עובדת&nbsp;AI</figcaption></figure>
          <div class="learned-bubble">
            <p class="learned-title">קיבלתי ממך:</p>
            <ul>
              <li>המייל ללקוח: כתוב בקול שלך, ומחכה&nbsp;לאישור.</li>
              <li>הרעיון החדש: רשמתי, ואני ממליצה לסגור קודם את מה&nbsp;שפתוח.</li>
            </ul>
          </div>
        </div>
        <p class="said rev"><span class="b-punch">לצוות שכבר מכיר אותך מסבירים פעם אחת, ולך&nbsp;נשאר&nbsp;לבדוק&nbsp;ולאשר.</span></p>
      </div>
    </section>

    <!-- ===== המשרד: הצוות, והכיסא הפנוי ===== -->
    <section id="office">
      <div class="wrap">
        <h2 class="rev-h">ומי בצוות?</h2>
        <p class="rev">זה <span class="pencil">"המשרד"</span>: צוות של עובדי AI שיושב בתיקייה במחשב שלך. זו גרסה של המשרד שאני מנהל ממנו את העסק שלי, ואני נותן אותה במתנה, מעבר לסדנה, כמו שהיא. אחרי שהתקנת, "המשרד" הוא שלך, ואפשר לשנות בו מה שבא&nbsp;לך.</p>
        <ul class="team rev" aria-label="הצוות שמגיע איתך">
          <li><Image src={teamRozin} alt="" width={330} /><b>רוזין</b><span>כותבת בקול שלך</span></li>
          <li><Image src={teamEditor} alt="" width={330} /><b>העורך</b><span>בודק הכול לפני שזה&nbsp;יוצא</span></li>
          <li><Image src={teamDale} alt="" width={330} /><b>דייל</b><span>סוגר איתך את היום, ורושם מה&nbsp;שלימדת</span></li>
          <li class="team-next"><span class="plus" aria-hidden="true">+</span><b>העובד הראשון שלך</b><span>אותו לומדים לגייס&nbsp;בסדנה</span></li>
        </ul>
        <p class="team-catch rev"><strong>הם כבר יודעים לעבוד. <span class="nb">עליך הם עוד לא יודעים כלום.</span></strong></p>
      </div>
    </section>

    <!-- ===== איך זה עובד: שלושה שלבים ===== -->
    <section id="inside">
      <div class="wrap">
        <h2 class="rev-h">אז איך הם לומדים&nbsp;אותי?</h2>

        <ol class="cards3 stages" aria-label="מה קורה מתי">
          <li class="card3 rev">
            <span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 18c1.1 0 1.99-.9 1.99-2L22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2H0v2h24v-2h-4zM4 6h16v10H4V6z"/></svg></span>
            <p class="stage-tag">לפני · בערך שעתיים</p>
            <h3>מכינים מקום לצוות, ומספרים לו&nbsp;עליך</h3>
            <p>לפי מדריך, צעד אחרי צעד: מתקינים את <bdi>Claude</bdi> ועוד שני כלים, ממלאים שאלון על העסק ואוספים כמה דברים&nbsp;שכתבת.</p>
          </li>
          <li class="card3 rev">
            <span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z"/></svg></span>
            <p class="stage-tag">בהקלטה · 13 שיעורים, בערך שעתיים</p>
            <h3>לומדים לגייס, ומתקינים את "המשרד"&nbsp;אצלך</h3>
            <p>בחלקים המעשיים עוצרים את הסרטון ועושים במחשב שלך את מה&nbsp;שראית.</p>
          </li>
          <li class="card3 rev">
            <span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 6h-2.18c.11-.31.18-.65.18-1 0-1.66-1.34-3-3-3-1.05 0-1.96.54-2.5 1.35l-.5.67-.5-.68C10.96 2.54 10.05 2 9 2 7.34 2 6 3.34 6 5c0 .35.07.69.18 1H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-5-2c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zM9 4c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm11 15H4v-2h16v2zm0-5H4V8h5.08L7 10.83 8.62 12 11 8.76l1-1.36 1 1.36L15.38 12 17 10.83 14.92 8H20v6z"/></svg></span>
            <p class="stage-tag">אחרי · שבע משימות</p>
            <h3>חפיפה, ואז עבודה&nbsp;אמיתית</h3>
            <p>לומדים את הצוות, והצוות לומד אותך. כל משימה בערך חצי שעה, ויש מי שעובר את זה ביומיים, ויש מי שבעשרה&nbsp;ימים.</p>
            <p>במשימה האחרונה נותנים לצוות עבודה ראשונה שהוא עושה לבד, גם בלילה, כשהמחשב נשאר&nbsp;דלוק.</p>
          </li>
        </ol>

        <div class="me-line rev">
          <Image class="me-ava" src={avatar} alt="גיא מלול" width={384} height={384} />
          <p><strong>אני גיא מלול, ואני מלמד בדיוק את מה שאני עושה בעסק שלי כל&nbsp;יום.</strong>
          מהנדס תוכנה במיקרוסופט, לפני זה הייתי באלביט <span class="nb">ובצ'ק פוינט</span>, ולפני כל זה הייתי הבעלים של <span class="nb">"חאן קסם המדבר"</span>, אתר תיירות במדבר, וניהלתי אותו כמעט <span class="nb">שבע שנים (<a class="body-link" href="https://www.linkedin.com/in/guy-malul-35223a78/" target="_blank" rel="noopener">LinkedIn</a>).</span></p>
        </div>
      </div>
    </section>

    <Proof
      part="chat"
      heading={['יופי, אבל זה עובד למישהו?', 'הנה מה שכתבו לי בוגרי הסדנה.']}
      ctaLabel="לקנות את הסדנה המוקלטת"
    />

    <!-- ===== בזום או בהקלטה ===== -->
    <section class="tone" id="compare">
      <div class="wrap">
        <h2 class="rev-h">ובמה זה שונה מהסדנה&nbsp;בזום?</h2>

        <div class="duo2">
          <div class="duo-col rev">
            <p class="duo-title">רק&nbsp;בהקלטה</p>
            <ul>
              <li>מתחילים היום, בלי לחכות לתאריך</li>
              <li>חצי שעה פה, <span class="nb">חצי שעה שם</span></li>
              <li>עוצרים, מחזירים אחורה, רואים שוב</li>
            </ul>
          </div>
          <div class="duo-col rev">
            <p class="duo-title">רק&nbsp;בזום</p>
            <ul>
              <li>אני שם, ועונה על שאלות תוך כדי</li>
              <li>עובדים יחד, עד חמישה משתתפים</li>
              <li>שלוש שעות ברצף, בתאריך קבוע מראש</li>
            </ul>
          </div>
        </div>
        <p class="rev"><strong>בשניהם:</strong> אותה סדנה, אותו "משרד" ואותה קבוצת&nbsp;בוגרים.</p>
      </div>
    </section>

    <!-- ===== למי זה, ומה צריך ===== -->
    <section class="tone" id="fit">
      <div class="wrap">
        <h2 class="rev-h">איך לדעת אם זה מתאים&nbsp;לי?</h2>
        <p class="rev"><strong>זה בשבילך</strong> אם כבר עבדת עם AI, אפילו רק בצ'אט, ובא לך ללמוד לגייס עובדי&nbsp;AI&nbsp;בעצמך.</p>

        <div class="callout callout--warn rev">
          <svg class="co-ic" aria-hidden="true"><use href="#ic-warn"/></svg>
          <div class="co-body">
            <span class="co-label">פחות בשבילך</span>
            <p>אם עוד לא עבדת עם AI, אם כבר בנית סוכנים בעצמך, או אם בא לך שמישהו יעשה את זה&nbsp;בשבילך.</p>
          </div>
        </div>

        <div class="needs rev">
          <p class="needs-title">מה צריך</p>
          <ul>
            <li>מחשב Windows או Mac</li>
            <li>מנוי <bdi>Claude</bdi> בתשלום: <bdi>Pro</bdi> זה 20 דולר לחודש, וזה מספיק בהתחלה</li>
            <li>אנגלית בסיסית</li>
          </ul>
        </div>

        <p class="soft-line rev">נשאר לך ספק? <a class="body-link" href={WA}>אפשר לכתוב לי</a></p>
      </div>
    </section>

    <!-- ===== ההצעה ===== -->
    <section class="tone" id="price">
      <div class="wrap">
        <h2 class="rev-h">אז מה בדיוק&nbsp;מקבלים?</h2>

        <div class="offer rev">
          <p class="offer-price">
            <span class="was"><span class="was-label">בזום</span> <s>1,000 ש"ח</s></span>
            <b>497 ש"ח</b>
          </p>
          <ul class="gets">
            <li><span class="yes" aria-hidden="true">✓</span><span>גישה ל-60 יום&nbsp;מהקנייה.</span></li>
            <li><span class="yes" aria-hidden="true">✓</span><span>13 שיעורים מוקלטים, בערך שעתיים.</span></li>
            <li><span class="yes" aria-hidden="true">✓</span><span>שאלות ותשובות מהסדנה: עוד שלושה&nbsp;שיעורים.</span></li>
            <li><span class="yes" aria-hidden="true">✓</span><span>מדריך ההכנה, צעד אחרי&nbsp;צעד.</span></li>
            <li><span class="yes" aria-hidden="true">✓</span><span>שבע משימות החפיפה.</span></li>
            <li><span class="yes" aria-hidden="true">✓</span><span>קבוצת הבוגרים בוואטסאפ.</span></li>
          </ul>
          <p class="rev">ומעבר לזה: <span class="pencil">"המשרד"</span>, מתנה&nbsp;ממני.</p>
          <p class="rev">ומה שאין: ליווי&nbsp;אישי.</p>
        </div>

        <p class="rev">משלמים, ותוך כמה דקות מגיע אליך מייל עם לינק&nbsp;אישי.</p>

        <div class="cta-row rev">
          <a class="btn" href={PAY}>לקנות את הסדנה המוקלטת</a>
        </div>
      </div>
    </section>

    <!-- ===== מה הם בנו: just before the questions, his call 17.11 ===== -->
    <Proof
      part="built"
      note="כל אלה נבנו אחרי הסדנה בזום."
      ctaLabel="לקנות את הסדנה המוקלטת"
    />

    <!-- ===== שאלות ===== -->
    <section>
      <div class="wrap">
        <h2 class="rev-h" id="faq">רגע, יש לי עוד&nbsp;שאלות.</h2>
        <div class="faq-list">
          <details class="rev">
            <summary><span>אין לי רקע טכני. זה בשבילי?</span><span class="tog" aria-hidden="true">+</span></summary>
            <div class="faq-body">לא צריך לדעת לתכנת, ולא כותבים אף שורת קוד.<br>
            כן צריך להרגיש בנוח מול מחשב ולהתקין תוכנה לפי הוראות.</div>
          </details>
          <details class="rev">
            <summary><span>למה דווקא Claude Code, ולא הכלי שכבר יש לי?</span><span class="tog" aria-hidden="true">+</span></summary>
            <div class="faq-body">הוא כלול במנוי <bdi>Claude</bdi>, והוא עובד ישר על הקבצים שבמחשב שלך, אז מה שלימדת אותו נשאר אצלך.<br>
            את השיטה אפשר לקחת לכל כלי, אבל הסדנה בנויה עליו.</div>
          </details>
          <details class="rev">
            <summary><span>אפשר לראות מהטלפון?</span><span class="tog" aria-hidden="true">+</span></summary>
            <div class="faq-body">את השיעורים כן. את ההכנה ואת ההתקנה עושים מהמחשב.</div>
          </details>
          <details class="rev">
            <summary><span>ומה אם אתקע באמצע?</span><span class="tog" aria-hidden="true">+</span></summary>
            <div class="faq-body">מדביקים ל-<bdi>Claude</bdi> את השגיאה, והוא מסביר בעברית ומתקן את זה איתך.<br>
            ואם נתקעת באמת, עונים למייל שקיבלת אחרי התשלום, והתשובה שלך מגיעה ישר אליי.</div>
          </details>
          <details class="rev">
            <summary><span>ומה קורה אחרי 60 יום?</span><span class="tog" aria-hidden="true">+</span></summary>
            <div class="faq-body">הגישה לשיעורים נסגרת. "המשרד" שהתקנת נשאר אצלך במחשב, וקבוצת הבוגרים נשארת פתוחה.</div>
          </details>
          <details class="rev">
            <summary><span>איפה נשמר המידע שלי?</span><span class="tog" aria-hidden="true">+</span></summary>
            <div class="faq-body">הקבצים נשמרים במחשב שלך, ולי אין אליהם גישה.<br>
            מה ששולחים ל-<bdi>Claude</bdi> עובר לשרתים שלו, כמו בצ'אט שלך היום.</div>
          </details>
          <details class="rev">
            <summary><span>ומה אם מחר יוצא כלי חדש?</span><span class="tog" aria-hidden="true">+</span></summary>
            <div class="faq-body">הכלים מתחלפים, המבנה נשאר.<br>
            מה שהצוות יודע עליך כתוב בקבצים אצלך, לא בתוך הכלי. וכש-<bdi>Claude</bdi> משתפר, הצוות שלך משתפר איתו.</div>
          </details>
        </div>
      </div>
    </section>

    <!-- ===== הכפתור ===== -->
    <section class="final">
      <div class="wrap">
        <div class="say">
          <h2 class="rev-h"><span class="nb">אז מתי אפשר להתחיל?</span> כבר&nbsp;היום.</h2>
        </div>
        <div class="act">
          <div class="cta-row">
            <a class="btn" href={PAY}>לקנות את הסדנה המוקלטת</a>
          </div>
          <p class="after rev">497 ש"ח, וגישה ל-60 יום.</p>
          <p class="soft-line">רוצה לשאול משהו קודם? <a class="body-link" href={WA}>אפשר לכתוב לי</a></p>
        </div>
      </div>
    </section>

  </main>

  <SiteFooter />
