  <script is:inline>
const store = window.localStorage;
const TASKS = 6;
const KEY = "misrad-prep2-";

function setOs(os) {
  document.documentElement.dataset.os = os;
  document.querySelectorAll("[data-os-pick]").forEach(b => b.setAttribute("aria-pressed", String(b.dataset.osPick === os)));
  try { store.setItem(KEY + "os", os); } catch (e) {}
}
(function () {
  let os = null;
  try { os = store.getItem(KEY + "os"); } catch (e) {}
  if (!os) os = /Mac/i.test(navigator.userAgent) ? "mac" : "win";
  document.documentElement.dataset.os = os;
})();

function refresh() {
  let done = 0;
  document.querySelectorAll("input[data-task]").forEach(c => { if (c.checked) done++; });
  const pill = document.getElementById("progress-pill");
  const txt = done === TASKS ? TASKS + "/" + TASKS + " מוכנים לסדנה ✔" : done + "/" + TASKS + " הושלמו";
  if (pill.textContent !== txt) pill.textContent = txt;
  document.getElementById("progress-bar").style.width = (done / TASKS * 100) + "%";
}

document.addEventListener("DOMContentLoaded", () => {
  setOs(document.documentElement.dataset.os);
  document.querySelectorAll("[data-os-pick]").forEach(b => b.addEventListener("click", () => setOs(b.dataset.osPick)));
  document.querySelectorAll("input[data-task]").forEach(c => {
    c.checked = store.getItem(KEY + c.dataset.task) === "1";
    c.addEventListener("change", () => {
      store.setItem(KEY + c.dataset.task, c.checked ? "1" : "0");
      refresh();
    });
  });
  refresh();
});
function copyPrompt(btn){
  const t=document.getElementById("test-prompt").textContent;
  navigator.clipboard.writeText(t).then(()=>{const o=btn.textContent;btn.textContent="הועתק, אפשר להדביק";setTimeout(()=>btn.textContent=o,1800);});
}
</script>
