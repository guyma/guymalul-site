---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
---

<Base
  title={"ההכנה לסדנה | העובד הראשון שלך"}
  description={"שש משימות לפני הסדנה: מנוי, התקנות, בדיקה, שאלון ותיקיית דוגמאות. מגיעים מוכנים, בונים בזום."}
  favicon={"data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🚀</text></svg>"}
  analytics={false}
>
  <style is:global>
  /* ===========================================================
     The locked brand language (core/design in guy-hq is the truth).
     Flat white ground, ONE warm coral - the fill means "you can
     press this", coloured TEXT is always the dark accent. Colour
     that cannot be pressed is a mark and a line. Cards are the
     discrete completable things (the tasks); everything else sits
     on the ground. A workshop-prep page: desktop first.
     =========================================================== */
  :root {
    --ground: #ffffff;
    --tone:   #fef0ec;   /* groups; here it holds the support panel */
    --ink:    #2b1f1c;   /* ~15:1 on white */
    --body:   #6b5a55;   /* ~6.3:1 */
    --muted:  #7d6e69;   /* ~5:1 */
    --line:      #eee6e3;
    --line-tone: #f4d8d0;
    --acc:      #d4654e;   /* fills only; white on it is the brand's one AA exception */
    --acc-d:    #a84634;   /* ~5.6:1 on white - coloured TEXT and hover */
    --acc-tint: #fdeae4;   /* flat wash, never a gradient */
    --acc-line: #f0c4b8;
    --elev-1: 0 3px 10px rgba(212,101,78,.12);  /* the locked soft card shadow */
    --font: 'Rubik', system-ui, -apple-system, 'Segoe UI', sans-serif;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  html, body { overflow-x: hidden; max-width: 100%; }
  body { font-family: var(--font); font-size: 17px; background: var(--ground); color: var(--body); -webkit-font-smoothing: antialiased; line-height: 1.75; overflow-wrap: break-word; }
  ::selection { background: var(--acc-tint); }
  :focus-visible { outline: 3px solid var(--acc); outline-offset: 2px; }

  strong { color: var(--ink); font-weight: 700; }
  a { color: var(--acc-d); font-weight: 500; text-underline-offset: 0.2em; text-decoration-thickness: 1px; }

  /* the top bar: flat white, a hairline, and the one flat coral progress fill */
  .topbar { position: sticky; top: 0; z-index: 10; background: var(--ground); border-bottom: 1px solid var(--line); }
  .topbar-inner { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; padding: 12px 20px; }
  .topbar .brand { font-weight: 700; font-size: 0.95rem; letter-spacing: -0.02em; color: var(--ink); text-decoration: none; }
  .topbar .progress-pill { font-size: 0.85rem; color: var(--muted); }
  .progress-track { height: 3px; background: var(--line); }
  .progress-bar { height: 100%; width: 0%; background: var(--acc); transition: width 0.4s ease; }

  main { max-width: 720px; margin: 0 auto; padding: 40px 20px 90px; }

  /* the task card: 16px corners, the tinted hairline, the locked soft shadow.
     Not pressable, so it never lifts and never wears the fill. */
  .card { background: var(--ground); border: 1px solid var(--line-tone); border-radius: 16px; padding: 28px 24px; margin-bottom: 20px; box-shadow: var(--elev-1); }

  /* the opening is a section, not a choosable thing - no card clothes */
  .card.opening { border: none; box-shadow: none; border-radius: 0; padding: 8px 0 6px; margin-bottom: 8px; }

  h1 { color: var(--ink); font-size: clamp(1.9rem, 4.5vw, 2.5rem); font-weight: 700; line-height: 1.2; margin-bottom: 12px; letter-spacing: -0.02em; text-wrap: balance; }
  /* under the H1: the mark - a solid accent rule, none of the button's clothes */
  .h1-underline { width: 44px; height: 5px; border-radius: 0; background: var(--acc); margin-bottom: 18px; }
  .opening p { margin-bottom: 12px; }
  .opening p:last-child { margin-bottom: 0; }

  /* the phase marker: the kicker signature - mark and line, never a pill */
  .phase { display: flex; align-items: center; gap: 10px; margin: 44px 0 18px; }
  .phase::before { content: ""; flex: none; width: 22px; height: 4px; background: var(--acc); }
  .phase span { font-size: 15px; font-weight: 500; color: var(--acc-d); }

  .task-head { display: flex; align-items: baseline; gap: 12px; }
  .task-num { flex-shrink: 0; width: 30px; height: 30px; border-radius: 50%; background: var(--acc); color: #fff; font-weight: 700; display: grid; place-items: center; font-size: 0.95rem; align-self: center; }
  .task h2 { color: var(--ink); font-size: 19px; font-weight: 700; flex: 1; }
  .task .time { font-size: 0.8rem; color: var(--muted); white-space: nowrap; }
  .task-body { margin-top: 12px; font-size: 0.96rem; }
  .task-body ul { list-style: none; display: grid; gap: 10px; margin-top: 8px; }
  .task-body ul li { padding-inline-start: 24px; position: relative; }
  /* the list marker echoes the mark: a small solid accent rule, flat */
  .task-body ul li::before { content: ""; position: absolute; inset-inline-start: 0; top: 0.62em; width: 12px; height: 3px; background: var(--acc); }

  /* the plain note: an aside - an indent and a hairline, never a box */
  .callout { margin-top: 14px; padding-inline-start: 1.1rem; border-inline-start: 2px solid var(--line); color: var(--ink); font-size: 0.95rem; }
  /* the constraint: the tint frame with the accent spine; the icon and the
     bold opening word carry the meaning, the colour only sets temperature */
  .callout.warn { padding: 13px 16px; border: 1px solid var(--acc-line); border-inline-start: 4px solid var(--acc); background: var(--acc-tint); border-radius: 16px; }
  .callout .w-icon { margin-inline-end: 6px; }

  details.branch { margin-top: 12px; border: 1px solid var(--line); border-radius: 12px; background: var(--ground); }
  details.branch summary { cursor: pointer; padding: 10px 14px; font-weight: 500; font-size: 0.92rem; color: var(--ink); }
  details.branch summary:focus-visible { outline: 3px solid var(--acc); outline-offset: 2px; border-radius: 12px; }
  details.branch[open] summary { border-bottom: 1px solid var(--line); }
  details.branch .b-body { padding: 10px 14px; font-size: 0.92rem; color: var(--body); display: grid; gap: 8px; }

  /* the completion line: a hairline over the card's foot, no box. The "how you
     know you're done" line is coloured text, so it is the dark accent. */
  .check-row { margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--line-tone); }
  .check-row .how { font-size: 0.9rem; font-weight: 500; color: var(--acc-d); margin-bottom: 8px; }
  .check-row label { display: flex; align-items: center; gap: 10px; cursor: pointer; font-weight: 500; font-size: 1rem; color: var(--ink); }
  .check-row input { width: 20px; height: 20px; accent-color: var(--acc); flex-shrink: 0; }

  /* the pressable signature: flat solid fill, 12px rounded rectangle */
  .big-link { display: inline-flex; align-items: center; justify-content: center; min-height: 46px; background: var(--acc); color: #fff !important; font-weight: 500; border-radius: 12px; padding: 10px 26px; text-decoration: none; margin-top: 10px; transition: background-color 0.15s ease; }
  .big-link:hover, .big-link:focus-visible { background: var(--acc-d); }

  h2.sec { color: var(--ink); font-size: 19px; font-weight: 700; margin-bottom: 10px; }
  /* the support panel: the one tone ground, grouping the close */
  .card.support { background: var(--tone); border: none; box-shadow: none; }
  .support p { font-size: 0.96rem; }

  /* the system switch: two pressables; the picked one is filled AND carries a check
     mark, so the state never rests on colour alone */
  .os-switch { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 26px 0 0; }
  .os-switch .os-label { font-weight: 500; color: var(--ink); }
  .os-switch button { font-family: inherit; font-size: 0.95rem; font-weight: 500; min-height: 40px; padding: 6px 18px; border-radius: 12px; border: 2px solid var(--acc); background: var(--ground); color: var(--acc-d); cursor: pointer; }
  .os-switch button[aria-pressed="true"] { background: var(--acc); color: #fff; }
  .os-switch button[aria-pressed="true"]::before { content: "✓ "; }
  html:not([data-os="mac"]) .os-mac { display: none; }
  html[data-os="mac"] .os-win { display: none; }


  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
</style>
<div class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="#top">העובד הראשון שלך</a>
    <span class="progress-pill" id="progress-pill" role="status" aria-live="polite">0/6 הושלמו</span>
  </div>
  <div class="progress-track"><div class="progress-bar" id="progress-bar"></div></div>
</div>

<main id="top">
  <section class="card opening">
    <h1>מגיעים מוכנים לסדנה</h1>
    <div class="h1-underline"></div>
    <p>
      תראו, יש פה תהליך התקנה לא קצר, אבל באמת שהוא פשוט מאוד ומתאים לכל אחד!<br>
      זה יכול להישמע קצת מלחיץ, במיוחד כששומעים "קלוד <strong>קוד</strong>",
      אבל אל תחששו, זה בסך הכול רצף פעולות טכניות שצריך לבצע באופן
      <strong>חד פעמי</strong>.
    </p>
    <div class="callout warn">
      <span class="w-icon">⚠️</span><strong>חשוב מאוד:</strong><br>
      מנוי בתשלום חובה. אי אפשר לעבוד עם המנוי החינמי.<br>
      אני רוצה שבסדנה ממש תעבדו ותבנו על העסק האמיתי שלכם.<br>
      בשביל זה הכול צריך להיות מותקן, ואתם צריכים להכין את כל החומרים של העסק
      בתיקייה.
    </div>
    <p style="margin-top:12px;">
      <strong>תתחילו כמה ימים לפני הסדנה</strong>, לא ערב לפני. בלי ההתקנות לא
      תוכלו לעבוד בסדנה וחבל, זה כל הכיף!<br>
      יש לנו שלוש שעות ביחד, נרצה להשקיע את כל הזמן בבנייה ולמידה ולא בהתקנות.
    </p>
    <p>
      <strong>לעבוד מהמחשב (ועם אותו מחשב שתגיעו איתו לסדנה!), לא מהפלאפון ולא
      מהטאבלט.</strong>
    </p>
    <p>הסדנה בזום, מאותו מחשב. אין זום במחשב? מורידים מ-<a href="https://zoom.us/download" target="_blank" rel="noopener">zoom.us/download</a> ומתקינים.</p>
    <div class="os-switch" role="group" aria-label="מערכת ההפעלה של המחשב">
      <span class="os-label">המחשב שלכם:</span>
      <button type="button" data-os-pick="win" aria-pressed="true">Windows</button>
      <button type="button" data-os-pick="mac" aria-pressed="false">Mac</button>
    </div>
  </section>

  <div class="phase"><span>שלב א׳: החשבון וההתקנות</span></div>

  <!-- ============ Task 1 ============ -->
  <section class="card task">
    <div class="task-head"><div class="task-num">1</div><h2>חשבון Claude בתשלום</h2><span class="time">כ-5 דקות</span></div>
    <div class="task-body">
      <p>אני מלמד בסדנה לעבוד עם Claude Code, וזה דורש מנוי בתשלום: Pro
      (20$ לחודש) ומעלה. מתחילים ב-Pro, וכשנגמרת המכסה עולים ל-Max.
      תזהרו, זה ממכר 😉</p>
      <ul>
        <li>נכנסים אל <a href="https://claude.ai" target="_blank" rel="noopener">claude.ai</a> ולוחצים Sign up. נרשמים עם המייל שלכם או עם חשבון Google. רואים: מסך השיחה של Claude, אתם בפנים.</li>
        <li>פותחים את תפריט החשבון (לוחצים על השם או על סמל הפרופיל), בוחרים Settings, ומחפשים שם Billing או Plan. זה העמוד שמראה על איזה מסלול אתם.</li>
        <li>כתוב שם Free? לוחצים Upgrade, בוחרים Pro או Max, וממלאים פרטי תשלום. בסיום, באותו עמוד יהיה כתוב Pro או Max.</li>
      </ul>
    </div>
    <div class="check-row">
      <p class="how">סיימתם כשבעמוד ה-Billing של claude.ai כתוב Pro או Max.</p>
      <label><input type="checkbox" data-task="1"><span>יש לי מנוי פעיל</span></label>
    </div>
  </section>

  <!-- ============ Task 2 ============ -->
  <section class="card task">
    <div class="task-head"><div class="task-num">2</div><h2>מתקינים את Claude Code</h2><span class="time">כ-10 דקות</span></div>
    <div class="task-body">
      <ul>
        <li class="os-win">נכנסים אל <a href="https://claude.com/download" target="_blank" rel="noopener">claude.com/download</a> ולוחצים על כפתור ההורדה ל-Windows. הקובץ יורד לתיקיית Downloads.</li>
        <li class="os-win">לוחצים פעמיים על הקובץ שירד ומחכים שההתקנה תסתיים. בסיום Claude נפתח לבד, או שמוצאים אותו בתפריט Start.</li>
        <li class="os-mac">נכנסים אל <a href="https://claude.com/download" target="_blank" rel="noopener">claude.com/download</a> ולוחצים על ההורדה ל-macOS. צריך macOS 13 ומעלה: את הגרסה שלכם רואים בתפריט התפוח למעלה ← About This Mac.</li>
        <li class="os-mac">פותחים את הקובץ שירד וממשיכים לפי מה שמופיע על המסך. בסוף פותחים את Claude מתיקיית Applications. ה-Mac שואל אם לפתוח אפליקציה שהורדה מהאינטרנט? בודקים שכתוב Claude ולוחצים Open.</li>
        <li>לוחצים Sign in. נפתח דפדפן עם עמוד התחברות: מתחברים עם החשבון מהמשימה הקודמת ומאשרים. חוזרים לחלון של Claude (אם הוא לא קפץ לבד, לוחצים עליו<span class="os-win"> בשורת המשימות למטה</span><span class="os-mac"> ב-Dock למטה</span>).</li>
        <li>בסרגל הצד של החלון, למעלה, לוחצים על <strong>Code</strong> (רואים שם רק סמלים? עוברים עליהם עם העכבר עד שמופיע <bdi>Code</bdi>). נפתח מסך עבודה עם תיבת כתיבה, בלי שום בקשת שדרוג. זה הבית של העובד שלכם.</li>
      </ul>
      <details class="branch os-win"><summary>Windows מציג חלון אזהרה כחול על הקובץ?</summary><div class="b-body">
        <p>זה מסך הבדיקה של Windows (SmartScreen). לוחצים More info ובודקים את
        שורת המפרסם: <strong>Publisher: Anthropic, PBC</strong>. זה מה שכתוב?
        לוחצים Run anyway. כתוב שם אחר, או שאין שם מפרסם? עוצרים, לא מריצים,
        וכותבים לי.</p>
      </div></details>
    </div>
    <div class="check-row">
      <p class="how">סיימתם כשלשונית Code נפתחת עם תיבת כתיבה, בלי בקשת שדרוג.</p>
      <label><input type="checkbox" data-task="2"><span>Claude Code מותקן ומחובר</span></label>
    </div>
  </section>

  <!-- ============ Task 3 ============ -->
  <section class="card task">
    <div class="task-head"><div class="task-num">3</div><h2>מתקינים את Git ו-Node</h2><span class="time">כ-10 דקות</span></div>
    <div class="task-body">
      <div class="callout warn"><span class="w-icon">⚠️</span>שתי ההתקנות נדרשות לסדנה: דרך <bdi>Git</bdi>, <bdi>Claude</bdi> מריץ את הפקודות שלו מאחורי הקלעים, ועליו עובד גם הגיבוי של המשרד. על <bdi>Node</bdi> רצים כלים שמגיעים עם המשרד, כבר בסדנה.</div>
      <ul>
        <li class="os-win">נכנסים אל <a href="https://git-scm.com/downloads/win" target="_blank" rel="noopener">git-scm.com/downloads/win</a> ולוחצים על קישור ההורדה הראשון (Click here to download).</li>
        <li class="os-win">מריצים את הקובץ שירד. אם מופיעה אזהרת מפרסם: החותם הרשמי של Git for Windows הוא Johannes Schindelin. זה השם? ממשיכים. שם אחר? עוצרים ושואלים אותי.</li>
        <li class="os-win">יגיעו הרבה מסכי אפשרויות בזה אחר זה. לוחצים Next בכולם בלי לשנות כלום, גם במסכים שנראים מסובכים (בחירת עורך, שם ה-branch). בסוף לוחצים Finish.</li>
        <li class="os-win">ועוד התקנה אחת, באותה שיטה בדיוק: נכנסים אל <a href="https://nodejs.org" target="_blank" rel="noopener">nodejs.org</a> ולוחצים על כפתור ההורדה הירוק (גרסת LTS). מריצים את הקובץ שירד, Next בכל המסכים ובסוף Finish.</li>
        <li class="os-win">סוגרים את Claude לגמרי ופותחים מחדש, כדי שיזהה את שתי ההתקנות. אם נשאר סמל של Claude באזור השעון, קליק ימני עליו ואז Quit לפני הפתיחה מחדש.</li>
        <li class="os-mac">את Git לא מתקינים לבד: הוא מגיע עם כלי המפתחים של Apple. אם בבדיקה במשימה 4 קופץ חלון שמציע להתקין developer tools, לוחצים Install ומחכים שיסתיים.</li>
        <li class="os-mac">את Node מורידים מ-<a href="https://nodejs.org" target="_blank" rel="noopener">nodejs.org</a>: בוחרים את קובץ ההתקנה ל-macOS, זה שהשם שלו נגמר ב-.pkg, פותחים אותו ולוחצים Continue עד הסוף.</li>
        <li class="os-mac">בסוף סוגרים את Claude לגמרי, Command ו-Q, ופותחים מחדש.</li>
      </ul>
    </div>
    <div class="check-row">
      <p class="how"><span class="os-win">סיימתם כששתי ההתקנות הגיעו ל-Finish ו-Claude נסגר ונפתח.</span><span class="os-mac">סיימתם כש-Node הותקן ו-Claude נסגר ונפתח.</span> האימות: בבדיקה במשימה 4.</p>
      <label><input type="checkbox" data-task="3"><span>Git ו-Node מותקנים (האימות בבדיקה)</span></label>
    </div>
  </section>

  <div class="phase"><span>שלב ב׳: בדיקה שהכול עובד</span></div>

  <!-- ============ Task 4 ============ -->
  <section class="card task">
    <div class="task-head"><div class="task-num">4</div><h2>הבדיקה: הרגע הראשון עם העובד</h2><span class="time">כ-10 דקות</span></div>
    <div class="task-body">
      <p>המשימה הכי חשובה בהכנה. אם היא עוברת, אתם מוכנים לסדנה.</p>
      <ul>
        <li>פותחים את <bdi>Claude</bdi> ונכנסים ל-<strong>Code</strong>.</li>
        <li>בשורה שמתחת לתיבת הכתיבה בוחרים <strong>Local</strong>, ולידה לוחצים על בחירת התיקייה (<bdi>Open folder</bdi>).</li>
        <li>בחלון שנפתח עוברים לתיקיית הבית שלכם במחשב (<bdi class="os-win">C:\Users\your-name</bdi><bdi class="os-mac">/Users/your-name</bdi>), יוצרים בה תיקייה חדשה בשם <strong>my-office</strong>, בדיוק ככה, ובוחרים אותה. <bdi>Claude</bdi> שואל אם לסמוך עליה? מאשרים.<br>
        לא מוצאים את תיקיית הבית? <span class="os-win">מקלידים בשורת הכתובת של החלון <bdi>%USERPROFILE%</bdi> ולוחצים Enter.</span><span class="os-mac">לוחצים Shift ו-Command ו-H ביחד. Finder בעברית? היא בתוך "משתמשים", בשם שלכם.</span></li>
      </ul>
      <div class="callout warn">
